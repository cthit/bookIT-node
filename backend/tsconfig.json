{
  "exclude": ["node_modules"],
  "include": ["./src/**/*"],
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./build",
    "rootDir": "./src",
    "types": ["node"]
  },
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Recommended"
}
