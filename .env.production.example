# Copy to .env at the repository root before using docker-compose.prod.yml.
# Generate separate DB_PASS and SECRET values with: openssl rand -hex 32
DB_USER=bookit
DB_PASS=
DB_NAME=bookit
SECRET=

# Register a Gamma client with callback https://bookit.example.org/api/callback.
BASE_URL=https://bookit.example.org
ISSUER_BASE_URL=https://gamma.example.org
CLIENT_ID=
CLIENT_SECRET=
API_KEY=

# Enable only behind exactly one trusted reverse proxy (TLS termination).
TRUST_PROXY=0
