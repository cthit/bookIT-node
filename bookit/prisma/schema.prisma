generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model event {
  id              String        @id @default(uuid()) @db.Uuid
  phone           String
  title           String
  description     String?
  start           DateTime      @db.Timestamp(3)
  end             DateTime      @db.Timestamp(3)
  created_at      DateTime      @default(now()) @db.Timestamp(3)
  updated_at      DateTime      @default(now()) @db.Timestamp(3)
  room            String[]
  // Gamma user ID; null once personal data is cleared.
  booked_by       String?       @db.Uuid
  // Gamma super group ID; null if Gamma did not know the group when converted.
  booked_as       String?       @db.Uuid
}

enum room {
  BIG_HUB
  GROUP_ROOM
  CTC
  THE_CLOUD
}

model rule {
  id          String   @id @default(uuid()) @db.Uuid
  day_mask    Int      @default(0)
  start_date  DateTime @db.Timestamp(3)
  end_date    DateTime @db.Timestamp(3)
  start_time  String
  end_time    String
  description String
  allow       Boolean  @default(true)
  priority    Int      @default(10)
  title       String
  room        room[]
  created_at  DateTime @default(dbgenerated("'2022-02-25 18:58:00.815359'::timestamp without time zone")) @db.Timestamp(3)
  updated_at  DateTime @default(dbgenerated("'2022-02-25 18:58:00.815359'::timestamp without time zone")) @db.Timestamp(3)
}

// Data migrations (bookit/src/data-migrations) that have been applied.
model data_migration {
  id         String   @id
  applied_at DateTime @default(now()) @db.Timestamp(3)
}
