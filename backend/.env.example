DB_USER=postgres
DB_PASS=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookit

DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/bookit

ISSUER_BASE_URL=https://auth.chalmers.it
BASE_URL=http://localhost:8080
CLIENT_ID=replace-with-gamma-client-id
CLIENT_SECRET=replace-with-gamma-client-secret
API_KEY=replace-with-client-api-key-id:replace-with-client-api-key

FRONTEND_URL=http://localhost:3001 # URL to the frontend used for proxying

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=""

# Generate locally with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=8080
TZ=Europe/Stockholm
# Enable only behind exactly one trusted reverse proxy (TLS termination).
TRUST_PROXY=0
